generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Connection URLs are no longer declared here in Prisma 7.
  // - CLI (migrations/push): configured in prisma.config.ts via DIRECT_URL
  // - Runtime (PrismaClient): passed via the adapter option in src/lib/prisma.ts
  provider = "postgresql"
}

// ─── NextAuth Adapter Models ───────────────────────────────────────────────────
// Required by @auth/prisma-adapter. Do not rename these models or their fields.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Bcrypt hash for credentials users. Null for OAuth-only accounts.
  password      String?

  // Profile fields — collected in onboarding/Settings, not during registration
  /// University name. Null until the user fills it in during onboarding.
  university    String?
  /// ISO 3166-1 alpha-2 country code (e.g. "US", "AU"). Defaults to "US".
  country       String    @default("US")

  // Home currency — linked to the Currency lookup table
  homeCurrencyId String?
  homeCurrency   Currency? @relation("UserHomeCurrency", fields: [homeCurrencyId], references: [id])

  // Email verification — custom token stored on the user (not the Auth.js VerificationToken table)
  /// Single-use token sent in the verification email link.
  emailVerificationToken  String?   @unique
  /// When the token expires (24 hours after creation).
  emailVerificationExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Nomadent entity relations
  expenses   Expense[]
  tasks      Task[]
  goals      Goal[]
  deadlines  Deadline[]
  categories Category[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Currency ──────────────────────────────────────────────────────────────────

model Currency {
  id      String   @id @default(cuid())
  name    String   @unique // ISO 4217 currency code, e.g. "USD", "EUR"
  symbol  String   // e.g. "$", "€"
  details String   // Full name, e.g. "US Dollar", "Euro"

  users    User[]    @relation("UserHomeCurrency")
  expenses Expense[]
  goals    Goal[]
}

// ─── Category ──────────────────────────────────────────────────────────────────

model Category {
  id     String  @id @default(cuid())
  name   String  // e.g. "Food & Groceries"
  color  String? // Hex or tailwind color code for UI
  userId String? // Null for global categories; user ID for user-specific ones

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([name, userId])
}

// ─── Priority ──────────────────────────────────────────────────────────────────

model Priority {
  id    String @id @default(cuid())
  name  String @unique // e.g. "LOW", "MEDIUM", "HIGH"
  level Int    // Numeric level for sorting (e.g. 1, 2, 3)
  color String // UI rendering color
  tasks Task[]
}

// ─── Status ───────────────────────────────────────────────────────────────────

model Status {
  id    String @id @default(cuid())
  name  String @unique // e.g. "TODO", "IN_PROGRESS", "DONE"
  order Int    // Sorting order in Kanban board/list
  color String // UI rendering color
  tasks Task[]
}

// ─── Expense ───────────────────────────────────────────────────────────────────

model Expense {
  id              String   @id @default(cuid())
  userId          String
  title           String
  /// Amount in the original transaction currency
  amount          Float
  currencyId      String
  currency        Currency @relation(fields: [currencyId], references: [id])
  /// Amount converted to the user's home currency at time of entry
  convertedAmount Float
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  date            DateTime
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
}

// ─── Task ──────────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  priorityId  String
  priority    Priority  @relation(fields: [priorityId], references: [id])
  statusId    String
  status      Status    @relation(fields: [statusId], references: [id])
  completed   Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, dueDate])
}

// ─── Goal ──────────────────────────────────────────────────────────────────────

model Goal {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?   @db.Text
  targetAmount  Float
  currentAmount Float     @default(0)
  currencyId    String?
  currency      Currency? @relation(fields: [currencyId], references: [id])
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Deadline ─────────────────────────────────────────────────────────────────

model Deadline {
  id              String       @id @default(cuid())
  userId          String
  title           String
  type            DeadlineType
  dueDate         DateTime
  notes           String?      @db.Text
  /// Weekly work-hour cap imposed by visa (only for VISA / OPT_CPT types)
  workHourCap     Int?
  /// Total hours logged this week against the cap
  workHoursLogged Float        @default(0)
  /// Days at which reminders have already fired, e.g. [30, 14]
  remindersSent   Int[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DeadlineType {
  VISA
  INSURANCE
  BIOMETRICS
  OPT_CPT
  DOCUMENT
  OTHER
}
